# Database PostgreSQL (Gunakan URL dari Neon.tech, Supabase, Railway, atau Render)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Port Server Backend
PORT=5000

# Akun Admin & Secret Token JWT (Ganti dengan password yang aman)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_anda
JWT_SECRET=buat_string_rahasia_acak_yang_panjang_untuk_jwt_2026
